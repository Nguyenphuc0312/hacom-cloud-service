# Frontend local, everything else on develop.
# Replace develop.example.com with the real shared dev host.

VITE_APP_BASE_PATH=/
VITE_API_BASE_URL=https://develop.example.com/api/v1
VITE_AUTH_BASE_URL=https://develop.example.com/api/v1/auth
VITE_WS_BASE_URL=wss://develop.example.com/ws
VITE_FILE_BASE_URL=https://develop.example.com

VITE_USE_AUTH_SERVICE=true
VITE_REFRESH_TOKEN_STORAGE_MODE=session
