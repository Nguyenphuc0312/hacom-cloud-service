# Include limit_req_zone and upstream in the nginx http context.
limit_req_zone $binary_remote_addr zone=hacom_cloud_api_per_ip:10m rate=20r/s;

upstream hacom_cloud_api {
    server hacom-cloud-api:8080;
    keepalive 32;
}

# Include these locations in the public Chat server block.
location = /cloud-api {
    return 308 /cloud-api/;
}

location ^~ /cloud-api/ {
    limit_req zone=hacom_cloud_api_per_ip burst=40 nodelay;

    rewrite ^/cloud-api/(.*)$ /$1 break;
    proxy_pass http://hacom_cloud_api;
    proxy_http_version 1.1;

    # Identity comes only from the bearer token. Never forward the demo owner
    # header from public clients.
    proxy_set_header Authorization $http_authorization;
    proxy_set_header X-Demo-User-ID "";

    # Generate correlation at the trusted edge instead of trusting a client
    # supplied request ID. These headers are diagnostics only, never identity.
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    proxy_connect_timeout 3s;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;

    # Browser access is same-origin through /cloud-api. Do not add wildcard
    # Access-Control-Allow-Origin or credentialed cross-origin CORS here.
}
