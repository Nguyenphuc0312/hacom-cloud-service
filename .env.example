APP_ENV=local
API_ADDR=:8080
# Authentication mode: demo is allowed only for APP_ENV=local|test.
AUTH_MODE=demo
# JWT production profile (required when AUTH_MODE=jwt):
AUTH_JWKS_URL=https://chat.hacomholdings.com.vn/api/v1/auth/.well-known/jwks.json
AUTH_ISSUER=chat-service
AUTH_AUDIENCE=chat-service
AUTH_JWKS_CACHE_TTL=5m
AUTH_HTTP_TIMEOUT=3s
AUTH_REDIS_URL=redis://localhost:6379/0
AUTH_REVOCATION_TIMEOUT=500ms
# Temporary HS256 compatibility only. Keep disabled after Auth publishes RS256/ES256 JWKS.
AUTH_LEGACY_HS256_VERIFY_ENABLED=false
AUTH_LEGACY_HS256_SECRET=
# Auth-owned discovery/account-state contract. Required in JWT mode.
AUTH_VERIFICATION_CONTRACT_URL=http://localhost:3101/internal/v1/auth/verification-contract
AUTH_ACCOUNT_STATE_URL=http://localhost:3101/internal/v1/auth/check-account-state
AUTH_SERVICE_TOKEN_URL=http://localhost:3101/internal/v1/auth/service-token
AUTH_SERVICE_CLIENT_ID=hacom-cloud-service
AUTH_SERVICE_CLIENT_SECRET=
AUTH_SERVICE_TOKEN_AUDIENCE=chat-auth-service
# Keep empty unless the Auth service-client registration explicitly grants scopes.
AUTH_SERVICE_TOKEN_SCOPES=
POSTGRES_DB=hacom_cloud
POSTGRES_USER=hacom
POSTGRES_PASSWORD=hacom
DATABASE_URL=postgres://hacom:hacom@localhost:5432/hacom_cloud?sslmode=disable
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=hacom-cloud-private
# Proposed defaults pending product/mentor confirmation; both values use decimal bytes.
DEFAULT_QUOTA_BYTES=5000000000
MAX_CONTENT_BYTES=100000000
MAX_UPLOAD_BYTES=100000000
UPLOAD_URL_TTL=15m
DOWNLOAD_URL_TTL=15m
HEALTH_TIMEOUT=3s
SHUTDOWN_TIMEOUT=10s
WORKER_ID=
WORKER_POLL_INTERVAL=2s
WORKER_JOB_TIMEOUT=5m
WORKER_LOCK_TIMEOUT=6m
WORKER_MAX_ATTEMPTS=5
WORKER_BASE_BACKOFF=1s
WORKER_MAX_BACKOFF=1m
WORKER_CLEANUP_SCAN_INTERVAL=30s
WORKER_CLEANUP_BATCH_SIZE=100
TRASH_RETENTION=24h
WORKER_TRASH_SCAN_INTERVAL=30s
WORKER_TRASH_BATCH_SIZE=100
WORKER_METRICS_ADDR=:9091
