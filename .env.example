APP_ENV=local
API_ADDR=:8080
AUTH_MODE=demo
# Required when AUTH_MODE=jwt. Never put private keys in Cloud.
AUTH_JWKS_URL=http://localhost:3000/.well-known/jwks.json
JWT_ISSUER=hacom-auth
JWT_AUDIENCE=hacom-cloud
# Use the same Redis authority keys as chat-auth-service.
AUTH_REDIS_ADDR=localhost:6379
AUTH_REDIS_PASSWORD=
AUTH_REDIS_DB=0
AUTH_REVOCATION_URL=
AUTH_JWKS_CACHE_TTL=5m
AUTH_LEGACY_HS256_VERIFY_ENABLED=false
AUTH_LEGACY_HS256_SECRET=
AUTH_RATE_LIMIT=120
AUTH_RATE_WINDOW=1m
POSTGRES_DB=hacom_cloud
POSTGRES_USER=hacom
POSTGRES_PASSWORD=hacom
DATABASE_URL=postgres://hacom:hacom@localhost:5432/hacom_cloud?sslmode=disable
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=hacom-cloud-private
# Proposed defaults pending product/mentor confirmation; both values use decimal bytes.
DEFAULT_QUOTA_BYTES=5000000000
MAX_CONTENT_BYTES=100000000
MAX_UPLOAD_BYTES=100000000
UPLOAD_URL_TTL=15m
HEALTH_TIMEOUT=3s
SHUTDOWN_TIMEOUT=10s
WORKER_ID=
WORKER_POLL_INTERVAL=2s
WORKER_JOB_TIMEOUT=5m
WORKER_LOCK_TIMEOUT=6m
WORKER_MAX_ATTEMPTS=5
WORKER_BASE_BACKOFF=1s
WORKER_MAX_BACKOFF=1m
WORKER_CLEANUP_SCAN_INTERVAL=30s
WORKER_CLEANUP_BATCH_SIZE=100
