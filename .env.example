# ============================================
# APP
# ============================================
VITE_APP_BASE_PATH=/admin/
VITE_APP_ENV=DEV
VITE_DASHBOARD_REFETCH_INTERVAL_MS=15000
VITE_ADMIN_WRITE_ACTIONS_ENABLED=false
VITE_LIVE_UPDATES_URL=
VITE_WS_URL=

# ============================================
# ADMIN API
# ============================================
# Shared API base used by the panel for non-admin routes.
VITE_API_BASE_URL=/api/v1

# Canonical public auth base. Prefer /api/v1/auth over legacy /auth alias.
VITE_AUTH_BASE_URL=/api/v1/auth

# Canonical admin backend root.
VITE_ADMIN_API_BASE_URL=/api/v1/admin

# Legacy alias kept for backward compatibility.
VITE_ADMIN_API_ROOT=/api/v1/admin

# ============================================
# DEV PROXY (Vite only)
# ============================================
# Used only by npm run dev to avoid CORS and callback/login mismatch.
VITE_DEV_ADMIN_PROXY_TARGET=http://localhost:3201
VITE_DEV_AUTH_PROXY_TARGET=http://localhost:3101
