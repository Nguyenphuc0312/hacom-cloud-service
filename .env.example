# ============================================
# CHAT WEB CLIENT - Environment Variables
# ============================================

# API service base URL (business APIs: users, rooms, messages, files, etc.)
VITE_API_BASE_URL=http://localhost:3001/api/v1

# ============================================
# AUTH SERVICE (Stage 1 – body mode migration)
# ============================================

# Auth-service base URL.  When USE_AUTH_SERVICE=true, auth calls
# (login/refresh/logout/me/register/…) go directly here.
VITE_AUTH_BASE_URL=http://localhost:3101/api/v1

# Feature flag: route auth traffic to dedicated auth-service.
#   true  → FE calls VITE_AUTH_BASE_URL for /auth/* endpoints.
#   false → FE calls VITE_API_BASE_URL (legacy, rollback).
VITE_USE_AUTH_SERVICE=true

# Refresh-token storage strategy:
#   session → sessionStorage (default, Stage 1 body mode)
#   cookie  → HttpOnly cookie (Stage 2 cookie mode)
VITE_REFRESH_TOKEN_STORAGE_MODE=session

# ============================================
# WEBSOCKET
# ============================================
VITE_WS_URL=ws://localhost:8001/ws
VITE_WEBSOCKET_URL=ws://localhost:8001
VITE_WS_USE_QUERY_TOKEN=false
VITE_WS_AUTO_QUERY_TOKEN_FALLBACK=true
