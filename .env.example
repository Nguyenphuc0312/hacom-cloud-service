# ============================================
# APP — shared defaults for all environments
# ============================================
# VITE_APP_ENV: development | staging | production | docker
VITE_APP_ENV=development
VITE_APP_BASE_PATH=/
VITE_DASHBOARD_REFETCH_INTERVAL_MS=15000

# Write actions (lock/unlock users, approve requests, etc.)
# Set to false in dev/staging, true in production when ready
VITE_ADMIN_WRITE_ACTIONS_ENABLED=false

# ============================================
# ADMIN API
# ============================================
# Canonical public auth base (used by authAxiosInstance)
VITE_AUTH_BASE_URL=/api/v1/auth
VITE_ACCESS_STATUS_POLL_MS=15000

# Canonical admin backend root (used by adminAxiosInstance)
VITE_ADMIN_API_BASE_URL=/api/v1/admin

# Legacy alias kept for backward compatibility
VITE_ADMIN_API_ROOT=/api/v1/admin

# ============================================
# DEV PROXY (Vite dev server only)
# ============================================
# Only used by npm run dev to route /api/* to local backend services
# These do NOT get bundled — only read by Vite dev server at runtime
VITE_DEV_ADMIN_PROXY_TARGET=http://localhost:3201
VITE_DEV_AUTH_PROXY_TARGET=http://localhost:3101

# ============================================
# WEBSOCKET
# ============================================
# For local dev with backend services
VITE_LIVE_UPDATES_URL=ws://localhost:8080/ws
VITE_WS_URL=ws://localhost:8080/ws
