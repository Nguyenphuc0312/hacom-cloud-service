# ============================================
# ⚠️ ĐỌC TRƯỚC KHI SỬA — KHÔNG XOÁ KHỐI NÀY
# ============================================
# File này VÀ file .env đều được git theo dõi. Mọi thứ viết vào đó sẽ lên
# remote và NẰM LẠI TRONG LỊCH SỬ VĨNH VIỄN.
#
# ⛔ KHÔNG đặt API key / token / mật khẩu / secret / DSN / private key.
# ✅ CHỈ đặt URL công khai, cờ bật/tắt, cấu hình không nhạy cảm.
#
# Giá trị bí mật → biến môi trường của máy hoặc CI secret, ở đây để trống.
# Có pre-commit hook chặn hộ nhưng `--no-verify` là qua được: đừng ỷ lại.
# ============================================

# ============================================
# APP
# ============================================
# Default local profile. For FE-local + develop, copy
# .env.dev.frontend-with-develop.example instead.
# Public base path when SPA is served under subpath. Keep "/" for local dev.
VITE_APP_BASE_PATH=/

# ============================================
# BACKEND PROFILE (choose one)
# ============================================
# Profile A (default): local frontend + local backend through Vite proxy
VITE_API_BASE_URL=/api/v1
VITE_AUTH_BASE_URL=/api/v1/auth
VITE_WS_BASE_URL=/ws
# Optional when media URLs are relative. Usually not required for local profile.
VITE_FILE_BASE_URL=
# HR/attendance base. Relative so it goes through the Vite /hr-api proxy.
# The extra /v1 makes the rewritten upstream path /api/v1/... match production.
VITE_HR_API_BASE_URL=/hr-api/v1

# Profile B: local frontend + public dev backend (uncomment and replace values)
# VITE_API_BASE_URL=https://hacom-chat.fitora.id.vn/api/v1
# VITE_AUTH_BASE_URL=https://hacom-chat.fitora.id.vn/api/v1/auth
# VITE_WS_BASE_URL=wss://hacom-chat.fitora.id.vn/ws
# VITE_FILE_BASE_URL=https://hacom-chat.fitora.id.vn

# Backward-compatible aliases (prefer VITE_WS_BASE_URL)
VITE_WS_URL=/ws
VITE_WEBSOCKET_URL=/ws

# ============================================
# AUTH MODE
# ============================================
# true: call dedicated auth-service
# false: rollback to API gateway path
VITE_USE_AUTH_SERVICE=true

# cookie | session
# cookie is the production-ready mode when auth-service issues HttpOnly refresh cookies.
VITE_REFRESH_TOKEN_STORAGE_MODE=cookie

# ============================================
# WEBSOCKET AUTH MODE
# ============================================
# Enable sanitized websocket event debug logs in the browser console.
VITE_SOCKET_DEBUG=false

# ============================================
# API REQUEST DEBUG (dev only)
# ============================================
# When true, axios aggregates raw HTTP requests over a rolling window and prints
# a console.table grouped by endpoint (count / duplicates / p95). Use it to spot
# N+1 / request storms (e.g. GET /users/:id vs POST /users/batch). Never enable
# in production. No tokens/headers/bodies are logged.
VITE_API_DEBUG_REQUESTS=false

# ============================================
# RENDER / ANIMATION DEBUG
# ============================================
# When true, disables presence/online indicator animation for clean paint traces.
VITE_DISABLE_PRESENCE_ANIMATION=false

# ============================================
# DEV PROXY (Vite only)
# ============================================
# Used only by npm run dev with relative API/WS values.
VITE_DEV_API_PROXY_TARGET=http://localhost:3001
VITE_DEV_AUTH_PROXY_TARGET=http://localhost:3101
VITE_DEV_WS_PROXY_TARGET=ws://localhost:8001
# Backing hosts for the /hr-api and /ai-api proxies (vite.config.ts:143-144).
# AI has no local equivalent, so it defaults to the deployed service.
VITE_DEV_HR_PROXY_TARGET=http://localhost:3000
VITE_DEV_AI_PROXY_TARGET=https://ai.hacomholdings.com.vn

# ============================================
# AI CHAT SERVICE
# ============================================
# Base URL của AI chat API. Dùng để validate open_url nguồn tham khảo.
# Chỉ URL thuộc origin này và path /api/sources/ mới được phép mở.
VITE_AI_CHAT_BASE_URL=https://ai.hacomholdings.com.vn
