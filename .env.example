APP_ENV=local
API_ADDR=:8080
POSTGRES_DB=hacom_cloud
POSTGRES_USER=hacom
POSTGRES_PASSWORD=hacom
DATABASE_URL=postgres://hacom:hacom@localhost:5432/hacom_cloud?sslmode=disable
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=hacom-cloud-private
MAX_UPLOAD_BYTES=100000000
HEALTH_TIMEOUT=3s
SHUTDOWN_TIMEOUT=10s
