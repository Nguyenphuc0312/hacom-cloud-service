# Production build overrides.
# Vite loads this file when mode=production (npm run build).
# Values here override .env for all production builds.
# NEVER commit real secrets here — only public build-time flags.

# HR/attendance API — direct URL for production builds
VITE_HR_API_BASE_URL=https://hrm.hacomholdings.com.vn/api/v1

# AI chat service — direct URL for production builds
VITE_AI_CHAT_BASE_URL=https://ai.hacomholdings.com.vn

# HttpOnly cookie mode: auth-service sets the refresh token cookie;
# the frontend must NOT read/write it from JS. Requires
# AUTH_REFRESH_COOKIE_ENABLED=true on the auth-service side.
VITE_REFRESH_TOKEN_STORAGE_MODE=cookie

# Disable WS event debug logs in production bundles.
VITE_SOCKET_DEBUG=false
