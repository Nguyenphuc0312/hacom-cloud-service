# ============================================
# APP
# ============================================
# VITE_APP_ENV: development | staging | production | docker
VITE_APP_ENV=production
VITE_APP_BASE_PATH=/
VITE_DASHBOARD_REFETCH_INTERVAL_MS=15000

# Write actions (lock/unlock users, approve requests, etc.)
# Set to false until admin panel is fully tested in production
VITE_ADMIN_WRITE_ACTIONS_ENABLED=false

# ============================================
# API BASE URLs
# ============================================
# PRODUCTION: Use absolute URLs pointing to your production/staging API gateway
# These get bundled into the app at build time
VITE_ADMIN_API_BASE_URL=https://admin-hacom-chat.fitora.id.vn/api/v1/admin
VITE_AUTH_BASE_URL=https://admin-hacom-chat.fitora.id.vn/api/v1/auth

# Legacy alias - kept for backward compatibility
VITE_ADMIN_API_ROOT=https://admin-hacom-chat.fitora.id.vn/api/v1/admin

# chat-api-service — ticket "Báo cáo sự cố" nằm ở chat-api, KHÔNG phải auth-service.
# ⚠️ DEPLOY: xác nhận origin chat-api thật + bật CORS_ALLOWED_ORIGINS cho origin admin panel.
VITE_CHAT_API_BASE_URL=https://hacom-chat.fitora.id.vn/api/v1

# ============================================
# WEBSOCKET
# ============================================
# Production WebSocket endpoint
VITE_LIVE_UPDATES_URL=wss://hacom-chat.fitora.id.vn/ws
VITE_WS_URL=wss://hacom-chat.fitora.id.vn/ws
