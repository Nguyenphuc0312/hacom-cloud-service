# Production build overrides.
# Vite loads this file when mode=production (npm run build).
# Values here override .env for all production builds.
# NEVER commit real secrets here — only public build-time flags.

# HR/attendance API — direct URL for production builds
VITE_HR_API_BASE_URL=https://hrm.hacomholdings.com.vn/api/v1

# AI chat service — direct URL for production builds
VITE_AI_CHAT_BASE_URL=https://ai.hacomholdings.com.vn

# HttpOnly cookie mode: auth-service sets the refresh token cookie;
# the frontend must NOT read/write it from JS. Requires
# AUTH_REFRESH_COOKIE_ENABLED=true on the auth-service side.
VITE_REFRESH_TOKEN_STORAGE_MODE=cookie

# Disable WS event debug logs in production bundles.
VITE_SOCKET_DEBUG=false

# Keep presence dots static during render/paint measurements when needed.
VITE_DISABLE_PRESENCE_ANIMATION=false

# Công & Phép (/timesheet, /leave, /timesheet/team) — bật trên production.
# Đặt "false" chỉ khi cần rollback tạm thời rồi build lại.
VITE_WORK_MODULE_ENABLED=true

# P5 in-app chat file viewer rollout. These public values are baked into a
# production bundle; only literal "true" enables them.
VITE_FILE_VIEWER_ENABLED=false
# Local allowlisted CustomEvent telemetry only; it has no remote collector.
VITE_FILE_LIFECYCLE_TELEMETRY_ENABLED=false

# Calendar attachments — tắt lớp MOCK (IndexedDB), nối chat-api/hr-api thật.
# ⚠️ Phụ thuộc hr-api prod có env CHAT_API_BASE_URL=https://chat.hacomholdings.com.vn/api/v1
# (set khi deploy). Nếu deploy FE trước khi hr-api có env → đính kèm resolve [] (event
# vẫn load, chỉ không có file) — không vỡ gì, tự đúng lại khi hr-api có env.
VITE_CALENDAR_ATTACHMENTS_MOCK=false
