{
  "name": "chat-web-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:gate": "node scripts/run-build-gate.mjs",
    "verify:dist": "node scripts/verify-dist-assets.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run --exclude \"**/*.bench.test.*\"",
    "test:perf:unit": "vitest run src/features/chat/performance/chatTimelinePerformance.bench.test.tsx",
    "test:chat-runtime": "vitest run src/features/chat/domain/messageMerge.test.ts src/features/chat/domain/messageMerge.readReceiptBatch.test.ts src/hooks/useMessageGrouping.inPlace.test.ts src/features/chat/hooks/useConversationTimelineRows.inPlace.test.tsx src/features/chat/simple-virtual-timeline/simpleMessageChange.test.ts src/features/chat/simple-virtual-timeline/useSimpleChatScroll.test.tsx src/features/chat/realtime/chatRealtimeAdapter.test.ts src/features/realtime/realtimeBatchCoordinator.test.ts src/hooks/useWebSocket.sync-machine.test.ts src/hooks/useSendMessage.test.tsx src/hooks/useUploadQueue.test.tsx src/features/chat/usecases/reaction-usecases.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:perf": "playwright test -c playwright.performance.config.ts",
    "test:e2e:headed": "playwright test --headed",
    "gate:static": "node scripts/production-readiness-gate.mjs",
    "ci:readiness": "npm run typecheck && npm run lint && npm run build:gate && npm test && npm run test:perf:unit && npm run gate:static",
    "ci:readiness:e2e": "npm run ci:readiness && npm run test:e2e && npm run test:e2e:perf",
    "analyze:bundle": "vite build --mode analyze",
    "e2e": "npm run test:e2e",
    "e2e:headed": "npm run test:e2e:headed",
    "lint": "eslint .",
    "preview": "vite preview",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:export-keys": "node scripts/i18n-export-keys.mjs"
  },
  "dependencies": {
    "@hacom/chat-shared-types": "file:../chat-shared-types",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^3.9.0",
    "@reduxjs/toolkit": "^2.8.2",
    "@tanstack/react-virtual": "^3.13.24",
    "@tiptap/core": "3.23.6",
    "@tiptap/extension-link": "3.23.6",
    "@tiptap/extension-placeholder": "3.23.6",
    "@tiptap/extension-text-style": "3.23.6",
    "@tiptap/react": "3.23.6",
    "@tiptap/starter-kit": "3.23.6",
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.7.1",
    "docx-preview": "^0.3.5",
    "framer-motion": "^12.38.0",
    "i18next": "^25.8.13",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.1",
    "lucide-react": "^1.14.0",
    "pdfjs-dist": "^4.10.38",
    "pdfmake": "^0.2.7",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.0",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "^16.5.4",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.12.0",
    "react-window": "^1.8.10",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.25",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
