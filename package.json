{
  "name": "chat-web-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:gate": "node scripts/run-build-gate.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:chat-runtime": "vitest run src/features/chat/domain/messageIdentityOrdering.test.ts src/features/chat/domain/messageMerge.test.ts src/features/api/chatApi.timeline.test.ts src/features/realtime/realtimeMiddleware.timeline.test.ts src/components/chat/useChatScrollController.test.tsx src/components/chat/MessageList.test.ts src/features/chat/hooks/useConversationMessagesRTK.test.tsx src/features/chat/hooks/useMessageJumpTargetRTK.test.tsx src/hooks/useSendMessage.test.tsx src/hooks/useUploadQueue.test.tsx src/components/input/MessageInput.test.tsx src/components/modals/ShareContactModal.test.tsx src/config/resourceUrlPolicy.test.ts src/services/tokenService.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:perf": "playwright test -c playwright.performance.config.ts",
    "test:e2e:headed": "playwright test --headed",
    "gate:static": "node scripts/production-readiness-gate.mjs",
    "ci:readiness": "npm run typecheck && npm run lint && npm run build:gate && npm test && npm run gate:static",
    "ci:readiness:e2e": "npm run ci:readiness && npm run test:e2e && npm run test:e2e:perf",
    "analyze:bundle": "vite build --mode analyze",
    "e2e": "npm run test:e2e",
    "e2e:headed": "npm run test:e2e:headed",
    "lint": "eslint .",
    "preview": "vite preview",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:export-keys": "node scripts/i18n-export-keys.mjs"
  },
  "dependencies": {
    "@hacom/chat-shared-types": "file:../chat-shared-types",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^3.9.0",
    "@reduxjs/toolkit": "^2.8.2",
    "@tanstack/react-virtual": "^3.13.24",
    "axios": "^1.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "i18next": "^25.8.13",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.0",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "^16.5.4",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.12.0",
    "react-window": "^1.8.10",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  }
}
