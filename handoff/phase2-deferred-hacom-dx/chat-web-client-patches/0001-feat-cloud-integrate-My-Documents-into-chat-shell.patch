+/*
+ * My Documents surface
+ * The Cloud API is presented as a private conversation, not a drive dashboard.
+ */
+.cloud-documents {
+  display: flex;
+  width: 100%;
+  height: 100%;
+  min-width: 0;
+  min-height: 0;
+  overflow: hidden;
+  background:
+    radial-gradient(
+      circle at 18% 8%,
+      hsl(var(--color-primary) / 0.035),
+      transparent 26rem
+    ),
+    hsl(var(--color-background));
+  color: hsl(var(--color-text-primary));
+}
+
+.cloud-documents__main {
+  display: flex;
+  min-width: 0;
+  min-height: 0;
+  flex: 1 1 auto;
+  flex-direction: column;
+}
+
+.cloud-documents__header {
+  display: flex;
+  min-height: 66px;
+  flex: 0 0 auto;
+  align-items: center;
+  justify-content: space-between;
+  gap: 20px;
+  border-bottom: 1px solid hsl(var(--color-border) / 0.82);
+  padding: 0 22px;
+  background: hsl(var(--color-surface) / 0.96);
+  backdrop-filter: blur(12px);
+}
+
+.cloud-documents__identity {
+  display: flex;
+  min-width: 0;
+  align-items: center;
+  gap: 11px;
+}
+
+.cloud-documents__avatar {
+  display: inline-flex;
+  width: 40px;
+  height: 40px;
+  flex: 0 0 auto;
+  align-items: center;
+  justify-content: center;
+  border: 1px solid hsl(var(--color-primary) / 0.18);
+  border-radius: 50%;
+  background:
+    linear-gradient(
+      145deg,
+      hsl(var(--color-primary) / 0.18),
+      hsl(var(--color-primary) / 0.07)
+    ),
+    hsl(var(--color-surface));
+  color: hsl(var(--color-primary));
+  box-shadow: 0 5px 16px hsl(var(--color-primary) / 0.09);
