+  overflow-y: auto;
+  padding: 20px 18px 28px;
+}
+
+.cloud-inspector__identity {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+
+.cloud-inspector__preview {
+  max-height: 220px;
+  margin-top: 18px;
+  overflow-y: auto;
+  border: 1px solid hsl(var(--color-border));
+  border-radius: 10px;
+  padding: 12px;
+  background: hsl(var(--color-background) / 0.7);
+  color: hsl(var(--color-text-secondary));
