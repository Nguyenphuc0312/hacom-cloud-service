+
+.cloud-capability-list > div {
+  display: flex;
+  align-items: center;
+  gap: 9px;
+  border-radius: 9px;
+  padding: 9px 10px;
+  background: hsl(var(--color-background));
+  color: hsl(var(--color-text-secondary));
+  font-size: 11px;
+  text-align: left;
+}
+
+@keyframes cloud-pulse {
+  0%,
+  100% {
+    opacity: 0.48;
+  }
+
+  50% {
+    opacity: 0.9;
+  }
+}
