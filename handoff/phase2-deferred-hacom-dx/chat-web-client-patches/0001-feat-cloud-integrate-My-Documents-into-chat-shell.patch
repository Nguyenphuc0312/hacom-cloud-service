+
+.cloud-documents__refresh {
+  flex: 0 0 auto;
+}
+
+.cloud-documents__tools {
+  display: flex;
+  min-height: 52px;
+  flex: 0 0 auto;
+  align-items: center;
+  justify-content: space-between;
+  gap: 20px;
+  border-bottom: 1px solid hsl(var(--color-border) / 0.72);
+  padding: 0 22px;
+  background: hsl(var(--color-surface));
+}
+
+.cloud-filter-tabs {
+  display: flex;
+  min-width: 0;
+  height: 52px;
+  align-items: stretch;
+  gap: 3px;
+  overflow-x: auto;
+  scrollbar-width: none;
+}
+
+.cloud-filter-tabs::-webkit-scrollbar {
+  display: none;
+}
+
+.cloud-filter-tab {
+  position: relative;
+  flex: 0 0 auto;
+  padding: 0 13px;
+  color: hsl(var(--color-text-muted));
+  font-size: 12px;
+  font-weight: 600;
+  white-space: nowrap;
+  transition:
+    color 140ms ease,
+    background-color 140ms ease;
+}
+
+.cloud-filter-tab::after {
+  position: absolute;
+  right: 12px;
+  bottom: 0;
+  left: 12px;
+  height: 2px;
+  border-radius: 999px 999px 0 0;
+  background: hsl(var(--color-primary));
+  content: "";
+  opacity: 0;
+  transform: scaleX(0.6);
+  transition:
+    opacity 140ms ease,
+    transform 140ms ease;
+}
