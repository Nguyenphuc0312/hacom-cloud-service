+  line-height: 1.55;
+}
+
+.cloud-inspector {
+  display: flex;
+  width: 320px;
+  min-width: 320px;
+  min-height: 0;
+  flex-direction: column;
+  overflow: hidden;
+  border-left: 1px solid hsl(var(--color-border));
