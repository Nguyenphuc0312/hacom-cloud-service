# Admin panel local, auth/admin backends on the dedicated admin host.
# Replace admin.server-test.example.com with the real shared dev admin host.

VITE_APP_ENV=DEV
VITE_DASHBOARD_REFETCH_INTERVAL_MS=15000
VITE_ADMIN_WRITE_ACTIONS_ENABLED=false
VITE_LIVE_UPDATES_URL=wss://server-test.example.com/ws
VITE_WS_URL=wss://server-test.example.com/ws

VITE_ADMIN_API_BASE_URL=https://admin.server-test.example.com/api/v1/admin
VITE_ADMIN_API_ROOT=https://admin.server-test.example.com/api/v1/admin
VITE_AUTH_BASE_URL=https://admin.server-test.example.com/api/v1/auth
VITE_ACCESS_STATUS_POLL_MS=15000
