# Admin panel local, admin/auth backends on server-test.
# Replace server-test.example.com with the real shared dev host.

VITE_APP_BASE_PATH=/admin/
VITE_APP_ENV=DEV
VITE_DASHBOARD_REFETCH_INTERVAL_MS=15000
VITE_ADMIN_WRITE_ACTIONS_ENABLED=false
VITE_LIVE_UPDATES_URL=wss://server-test.example.com/ws
VITE_WS_URL=wss://server-test.example.com/ws

VITE_API_BASE_URL=https://server-test.example.com/api/v1
VITE_ADMIN_API_BASE_URL=https://server-test.example.com/api/v1/admin
VITE_AUTH_BASE_URL=https://server-test.example.com/api/v1/auth
