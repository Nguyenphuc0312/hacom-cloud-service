# Chốt bảo mật cài đặt gói. Xem thêm: zskill/05-SKILL-CHO-PRJ.md (nhóm E).

# Không chạy script cài đặt của dependency.
#
# Đây là hàng rào chính chống supply-chain: một gói bị chiếm quyền (hoặc gói
# giả mạo tên) thực thi mã ngay lúc `npm install` qua preinstall/postinstall,
# với đúng quyền của người chạy lệnh — đọc được ~/.ssh, biến môi trường, token CI.
# Repo này là frontend thuần (React/Vite), không có dependency nào cần build
# native lúc cài, nên tắt hẳn không mất gì.
#
# Nếu sau này thêm gói THẬT SỰ cần install script, đừng bật lại cờ này cho toàn
# bộ cây phụ thuộc — chạy `npm rebuild <tên-gói>` đúng gói đó.
ignore-scripts=true

# Chỉ cài đúng phiên bản đã chốt trong lockfile.
# Chặn tình huống lockfile và package.json lệch nhau khiến máy này cài một bản
# khác máy kia (nguồn gốc của "chạy máy tôi thì được").
save-exact=true

# ⚠️ DEPENDENCY CONFUSION — chưa xử lý được ở tầng này.
#
# Gói nội bộ `@hacom/chat-shared-types` hiện trỏ `file:../chat-shared-types`
# (đường dẫn cục bộ) nên KHÔNG resolve qua registry → chưa khai thác được.
#
# Nhưng scope `@hacom` HIỆN CHƯA ĐƯỢC ĐĂNG KÝ trên npmjs.com. Ngày nào nhóm
# publish gói nội bộ lên một registry riêng, kẻ tấn công có thể publish
# `@hacom/<tên>` lên registry công khai với version cao hơn và cướp resolve.
#
# Khi đó BẮT BUỘC thêm dòng dưới (thay bằng URL registry thật):
#   @hacom:registry=https://registry.noi-bo-cua-ban/
# Chưa thêm bây giờ vì chưa có registry riêng — thêm vào sẽ làm hỏng `npm install`.
#
# Biện pháp rẻ hơn, làm được ngay: đăng ký phòng thủ scope `@hacom` trên
# npmjs.com để không ai khác chiếm được tên.
