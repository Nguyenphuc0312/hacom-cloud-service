# API service base URL (relative → vite proxy forward lên VITE_DEV_API_PROXY_TARGET)
VITE_API_BASE_URL=/api/v1

# Auth service base URL
VITE_AUTH_BASE_URL=/api/v1/auth
VITE_USE_AUTH_SERVICE=true
VITE_REFRESH_TOKEN_STORAGE_MODE=session

# WebSocket (relative → vite proxy forward lên VITE_DEV_WS_PROXY_TARGET)
VITE_WS_BASE_URL=/ws
VITE_WS_URL=/ws
VITE_WEBSOCKET_URL=/ws

# Dev proxy targets → production domain
VITE_DEV_API_PROXY_TARGET=https://chat.hacomholdings.com.vn
VITE_DEV_AUTH_PROXY_TARGET=https://chat.hacomholdings.com.vn
VITE_DEV_WS_PROXY_TARGET=wss://chat.hacomholdings.com.vn

# Media / avatar base URL
VITE_FILE_BASE_URL=https://chat.hacomholdings.com.vn
