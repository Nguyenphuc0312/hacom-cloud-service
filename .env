# API service base URL
VITE_API_BASE_URL=https://hacom-chat.fitora.id.vn/api/v1

# Auth service base URL
VITE_AUTH_BASE_URL=https://hacom-chat.fitora.id.vn/api/v1/auth
VITE_USE_AUTH_SERVICE=true
VITE_REFRESH_TOKEN_STORAGE_MODE=session

# WebSocket
VITE_WS_URL=ws://https://hacom-chat.fitora.id.vn/ws
VITE_WEBSOCKET_URL=ws://https://hacom-chat.fitora.id.vn
VITE_WS_USE_QUERY_TOKEN=false
VITE_WS_AUTO_QUERY_TOKEN_FALLBACK=true
