# ============================================
# ⚠️ ĐỌC TRƯỚC KHI SỬA — KHÔNG XOÁ KHỐI NÀY
# ============================================
# FILE NÀY ĐƯỢC GIT THEO DÕI. Mọi thứ viết vào đây sẽ lên remote và NẰM LẠI
# TRONG LỊCH SỬ VĨNH VIỄN — xoá ở commit sau cũng không gỡ được khỏi lịch sử.
#
# ⛔ TUYỆT ĐỐI KHÔNG ĐẶT VÀO ĐÂY:
#      API key, token, mật khẩu, secret, DSN, private key, chuỗi kết nối DB.
# ✅ CHỈ ĐẶT: URL công khai, cờ bật/tắt, cấu hình không nhạy cảm.
#
# Cần một giá trị bí mật? Đặt ở biến môi trường của máy hoặc CI secret,
# trong file này để trống — KHÔNG dán giá trị thật vào.
#
# Có pre-commit hook (scripts/check-env-secrets.mjs) chặn hộ, NHƯNG nó chỉ
# chặn tai nạn: `git commit --no-verify` là qua được. Đừng coi hook là bảo
# đảm — trách nhiệm cuối cùng là người sửa file này.
#
# Vì sao .env nằm trong git mà không gỡ: team muốn ai clone về cũng chạy dev
# trỏ thẳng backend production ("local như thật"). Gỡ đi thì mỗi người phải
# tự dựng lại một file giống hệt nhau. Chi tiết: LO-TRINH-VA-BAO-MAT-*.md (V-02).
# ============================================

# ============================================
# APP
# ============================================
# Default local profile. For FE-local + develop, copy
# .env.dev.frontend-with-develop.example instead.
# Public base path when SPA is served under subpath. Keep "/" for local dev.
VITE_APP_BASE_PATH=/

#Chat AI
VITE_HR_API_BASE_URL=https://hrm.hacomholdings.com.vn/api/v1
# Relative so AI calls go through the Vite /ai-api proxy (dodges the AI backend's
# CORS block against http://localhost). Prod build uses the absolute host.
VITE_AI_CHAT_BASE_URL=/ai-api

# ============================================
# BACKEND PROFILE (choose one)
# ============================================
# Profile A (default): local frontend + local backend through Vite proxy
VITE_API_BASE_URL=/api/v1
VITE_AUTH_BASE_URL=/api/v1/auth
VITE_WS_URL=/ws
# Optional when media URLs are relative. Usually not required for local profile.
VITE_FILE_BASE_URL=
# HR/attendance base. Relative so it goes through the Vite /hr-api proxy.
# The extra /v1 makes the rewritten upstream path /api/v1/... match production.
VITE_HR_API_BASE_URL=/hr-api/v1

# Profile B: local frontend + public dev backend (uncomment and replace values)
# VITE_API_BASE_URL=https://hacom-chat.fitora.id.vn/api/v1
# VITE_AUTH_BASE_URL=https://hacom-chat.fitora.id.vn/api/v1/auth
# VITE_WS_URL=wss://hacom-chat.fitora.id.vn/ws
# VITE_FILE_BASE_URL=https://hacom-chat.fitora.id.vn

# ============================================
# AUTH MODE
# ============================================
# true: call dedicated auth-service
# false: rollback to API gateway path
VITE_USE_AUTH_SERVICE=true

# cookie | session
# cookie is the production-ready mode when auth-service issues HttpOnly refresh cookies.
# For local FE + remote backend through the Vite proxy, use "session": prod cookies
# are Secure/Domain-scoped and get dropped over http://localhost, breaking refresh.
# Dev proxy đang trỏ vào backend production. Với localhost, Secure/Domain-scoped
# HttpOnly cookie sẽ không được browser lưu; dùng session để giữ refresh token
# theo vòng đời tab. Khi chạy toàn bộ backend local, đặt lại cookie.
VITE_REFRESH_TOKEN_STORAGE_MODE=session

# ============================================
# WEBSOCKET AUTH MODE
# ============================================
# Enable sanitized websocket event debug logs in the browser console.
VITE_SOCKET_DEBUG=false

# ============================================
# DEV PROXY (Vite only)
# ============================================
# Used only by npm run dev with relative API/WS values.
# Pointed at the deployed production backend so local FE runs like the live web app.
# Revert to http://localhost:3001 / 3101 / 8001 to use a local backend.
VITE_DEV_API_PROXY_TARGET=https://chat.hacomholdings.com.vn
VITE_DEV_AUTH_PROXY_TARGET=https://chat.hacomholdings.com.vn
VITE_DEV_WS_PROXY_TARGET=wss://chat.hacomholdings.com.vn
VITE_DEV_HR_PROXY_TARGET=https://hrm.hacomholdings.com.vn
VITE_DEV_AI_PROXY_TARGET=https://ai.hacomholdings.com.vn

# Media / avatar base URL
VITE_FILE_BASE_URL=https://chat.hacomholdings.com.vn

# AI chat service – relative so calls go through the Vite /ai-api proxy (CORS).
VITE_AI_CHAT_BASE_URL=/ai-api
