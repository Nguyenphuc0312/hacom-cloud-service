# ============================================
# LOCAL DEVELOPMENT OVERRIDES
# ============================================
# Copy this file to .env.local and customize for your local environment
# .env.local is gitignored - never commit actual local values

# ============================================
# OPTION A: Use Vite proxy (recommended for local dev)
# ----------------------------------------------
# When using proxy, set these to relative paths:
# VITE_ADMIN_API_BASE_URL=/api/v1/admin
# VITE_AUTH_BASE_URL=/api/v1/auth
# VITE_DEV_ADMIN_PROXY_TARGET=http://localhost:3201
# VITE_DEV_AUTH_PROXY_TARGET=http://localhost:3101
# VITE_WS_URL=ws://localhost:8080/ws

# ============================================
# OPTION B: Direct connection to staging/dev server
# ----------------------------------------------
# Uncomment and set these for direct connection (bypasses Vite proxy):
# VITE_ADMIN_API_BASE_URL=https://admin-hacom-chat.fitora.id.vn/api/v1/admin
# VITE_AUTH_BASE_URL=https://admin-hacom-chat.fitora.id.vn/api/v1/auth
# VITE_WS_URL=wss://hacom-chat.fitora.id.vn/ws

# ============================================
# WRITE ACTIONS
# ----------------------------------------------
# Enable write actions (lock/unlock, approve, etc.) in local dev
# Default is false for safety
# VITE_ADMIN_WRITE_ACTIONS_ENABLED=true
