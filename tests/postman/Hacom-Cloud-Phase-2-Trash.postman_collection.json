{
  "info": {
    "name": "Hacom Cloud - Phase 2 Trash Contract",
    "description": "Four Trash endpoints, quota breakdown, idempotency and ownership-safe responses.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "ownerId", "value": "11111111-1111-4111-8111-111111111111" },
    { "key": "otherOwnerId", "value": "22222222-2222-4222-8222-222222222222" },
    { "key": "itemId", "value": "00000000-0000-4000-8000-000000000000" },
    { "key": "operationKey", "value": "trash-contract-operation-1" }
  ],
  "item": [
    {
      "name": "00 - Create contract fixture",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Demo-User-ID", "value": "{{ownerId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"content\":\"Phase 2 Trash Postman fixture\"}"
        },
        "url": "{{baseUrl}}/api/v1/cloud/texts"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Fixture is created', () => pm.response.to.have.status(201));",
        "pm.collectionVariables.set('itemId', pm.response.json().id);",
        "pm.collectionVariables.set('operationKey', 'trash-' + pm.variables.replaceIn('{{$guid}}'));",
        "pm.collectionVariables.set('restoreKey', 'restore-' + pm.variables.replaceIn('{{$guid}}'));",
        "pm.collectionVariables.set('deleteKey', 'delete-' + pm.variables.replaceIn('{{$guid}}'));"
      ] } }]
    },
    {
      "name": "01 - Move item to Trash",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Demo-User-ID", "value": "{{ownerId}}" },
          { "key": "Idempotency-Key", "value": "{{operationKey}}" }
        ],
        "url": "{{baseUrl}}/api/v1/cloud/items/{{itemId}}/trash"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Trash returns 200', () => pm.response.to.have.status(200));",
        "pm.test('Retention is exactly 24h', function () { const b=pm.response.json(); pm.expect(new Date(b.purgeAfter)-new Date(b.deletedAt)).to.eql(86400000); });",
        "pm.test('No storage internals', function () { const s=pm.response.text(); pm.expect(s).not.to.include('objectKey'); pm.expect(s).not.to.include('bucket'); });"
      ] } }]
    },
    {
      "name": "01a - Retry move idempotently",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Demo-User-ID", "value": "{{ownerId}}" },
          { "key": "Idempotency-Key", "value": "{{operationKey}}" }
        ],
        "url": "{{baseUrl}}/api/v1/cloud/items/{{itemId}}/trash"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Retry returns stored result', () => pm.response.to.have.status(200));",
        "pm.test('Retry does not apply twice', () => pm.expect(pm.response.json().applied).to.eql(false));"
      ] } }]
    },
    {
      "name": "01b - Cross-owner remains hidden",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "X-Demo-User-ID", "value": "{{otherOwnerId}}" },
          { "key": "Idempotency-Key", "value": "cross-owner-delete" }
        ],
        "url": "{{baseUrl}}/api/v1/cloud/items/{{itemId}}"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Cross-owner target is indistinguishable from missing', () => pm.response.to.have.status(404));",
        "pm.test('No storage internals leak', function () { const s=pm.response.text(); pm.expect(s).not.to.include('objectKey'); pm.expect(s).not.to.include('bucket'); pm.expect(s).not.to.include('purge job'); });"
      ] } }]
    },
    {
      "name": "02 - List owner Trash",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Demo-User-ID", "value": "{{ownerId}}" }],
        "url": "{{baseUrl}}/api/v1/cloud/trash?limit=20"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Trash list returns 200', () => pm.response.to.have.status(200));",
        "pm.test('Only public metadata is returned', function () { const s=pm.response.text(); pm.expect(s).not.to.include('objectKey'); pm.expect(s).not.to.include('bucket'); });"
      ] } }]
    },
    {
      "name": "03 - Restore item",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Demo-User-ID", "value": "{{ownerId}}" },
          { "key": "Idempotency-Key", "value": "{{restoreKey}}" }
        ],
        "url": "{{baseUrl}}/api/v1/cloud/items/{{itemId}}/restore"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Restore returns 200', () => pm.response.to.have.status(200));",
        "pm.test('Item is ready', () => pm.expect(pm.response.json().status).to.eql('ready'));"
      ] } }]
    },
    {
      "name": "04 - Delete immediately",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "X-Demo-User-ID", "value": "{{ownerId}}" },
          { "key": "Idempotency-Key", "value": "{{deleteKey}}" }
        ],
        "url": "{{baseUrl}}/api/v1/cloud/items/{{itemId}}"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Delete is accepted', () => pm.response.to.have.status(202));",
        "pm.test('Async state is explicit', function () { const b=pm.response.json(); pm.expect(b).to.have.keys('itemId','status','async'); });"
      ] } }]
    },
    {
      "name": "05 - Quota breakdown",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Demo-User-ID", "value": "{{ownerId}}" }],
        "url": "{{baseUrl}}/api/v1/cloud/quota"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Quota returns 200', () => pm.response.to.have.status(200));",
        "pm.test('Quota invariant', function () { const q=pm.response.json(); pm.expect(q.activeBytes+q.trashBytes).to.eql(q.usedBytes); });"
      ] } }]
    }
  ]
}
